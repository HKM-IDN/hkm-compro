# ─────────────────────────────────────────────
# HKM Compro Vanilla — konfigurasi build
#
# Salin file ini jadi .env.local lalu isi nilainya.
# .env.local TIDAK ikut ter-commit (lihat .gitignore).
#
# Catatan: nama lama berawalan NEXT_PUBLIC_ juga masih dibaca,
# jadi .env.local dari project hkm-website bisa langsung dipakai.
# ─────────────────────────────────────────────

# ── WAJIB ──
# Ambil dari https://sanity.io/manage
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# ── OPSIONAL ──

# Domain situs — dipakai untuk canonical URL, sitemap, dan Open Graph
SITE_URL=https://hkm.co.id

# Google Analytics 4. Kosongkan untuk mematikan pelacakan.
GA_MEASUREMENT_ID=

# Google Maps — untuk peta service point.
# Kalau kosong atau ditolak, peta otomatis diganti kartu statis.
# Domain situs harus didaftarkan di Google Cloud Console → Credentials.
GOOGLE_MAPS_API_KEY=

# Formspree — tujuan form B2B dan kontak.
# Kalau kosong, form diganti ajakan kirim email langsung.
FORMSPREE_CONTACT_ENDPOINT=
